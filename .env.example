# Database Configuration
DB_HOST=mariadb
DB_PORT=3306
DB_ROOT_PASSWORD=123
DB_NAME=hrms
DB_USER=root

# Redis Configuration
REDIS_CACHE_HOST=redis
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST=redis
REDIS_QUEUE_PORT=6379
REDIS_SOCKETIO_HOST=redis
REDIS_SOCKETIO_PORT=6379

# Site Configuration
SITE_NAME=hrms.localhost
ADMIN_PASSWORD=admin
DEVELOPER_MODE=1

# Application Configuration
APP_PORT=8000

# Connection timeout settings
DB_CONNECT_TIMEOUT=30
REDIS_CONNECT_TIMEOUT=30

# For external database services (uncomment and modify as needed)
# DB_HOST=your-external-db.com
# DB_USER=your-db-user
# DB_ROOT_PASSWORD=your-secure-password
# REDIS_CACHE_HOST=your-external-redis.com
# REDIS_QUEUE_HOST=your-external-redis.com
# REDIS_SOCKETIO_HOST=your-external-redis.com
