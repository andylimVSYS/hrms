{
  "schemaVersion": 2,
  "dockerfileLines": [
    "FROM frappe/bench:latest",
    "USER root",
    "RUN apt-get update && apt-get install -y netcat-openbsd git && rm -rf /var/lib/apt/lists/*",
    "USER frappe",
    "WORKDIR /home/frappe",
    "RUN git clone https://github.com/andylimVSYS/hrms.git /tmp/hrms-source",
    "RUN cp /tmp/hrms-source/docker/init.sh /tmp/init.sh && chmod +x /tmp/init.sh",
    "RUN cp -r /tmp/hrms-source/hrms /tmp/hrms-app",
    "EXPOSE 8000",
    "CMD [\"bash\", \"/tmp/init.sh\"]"
  ]
}
