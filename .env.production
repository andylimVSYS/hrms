# Production Database Configuration (CapRover)
# Replace these with your actual external database details
DB_HOST=your-mariadb-host.com
DB_PORT=3306
DB_ROOT_PASSWORD=your-secure-password
DB_NAME=hrms_production
DB_USER=root

# Production Redis Configuration (CapRover)
# Replace these with your actual external Redis details
REDIS_CACHE_HOST=your-redis-host.com
REDIS_CACHE_PORT=6379
REDIS_QUEUE_HOST=your-redis-host.com
REDIS_QUEUE_PORT=6379
REDIS_SOCKETIO_HOST=your-redis-host.com
REDIS_SOCKETIO_PORT=6379

# Site Configuration
SITE_NAME=your-domain.com
ADMIN_PASSWORD=your-secure-admin-password
DEVELOPER_MODE=0

# Application Configuration
APP_PORT=8000
